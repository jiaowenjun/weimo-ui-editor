{
  "name": "weimo-ui-markdown",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaowenjun/weimo-ui-markdown.git"
  },
  "packageManager": "pnpm@12.10.1",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/md-editor-simple": {
      "types": "./dist/components/md-editor-simple/md-editor-simple.d.ts",
      "import": "./dist/components/md-editor-simple/md-editor-simple.js"
    },
    "./components/md-render-simple": {
      "types": "./dist/components/md-render-simple/md-render-simple.d.ts",
      "import": "./dist/components/md-render-simple/md-render-simple.js"
    },
    "./styles/tokens.css": {
      "types": "./dist/styles/tokens.d.css.ts",
      "default": "./dist/styles/tokens.css"
    },
    "./styles/markdown-content.css": {
      "types": "./dist/styles/markdown-content.d.css.ts",
      "default": "./dist/styles/markdown-content.css"
    },
    "./styles/md-editor-simple.css": {
      "types": "./dist/components/md-editor-simple/md-editor-simple.d.css.ts",
      "default": "./dist/components/md-editor-simple/md-editor-simple.css"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "site:dev": "pnpm build && pnpm --dir site dev",
    "site:build": "pnpm build && pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:typecheck": "pnpm typecheck",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "verify": "pnpm typecheck && pnpm test && pnpm check:package && pnpm --dir site build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weimo-ui-core": "~0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "weimo-ui-core": "github:jiaowenjun/weimo-ui-core#214e96706195b972c0c5bd64db0d613c1d6fd612"
  }
}
