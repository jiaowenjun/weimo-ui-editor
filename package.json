{
  "name": "weimo-ui-markdown",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaowenjun/weimo-ui-markdown.git"
  },
  "packageManager": "pnpm@12.10.1",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/rich-editor": {
      "types": "./dist/components/rich-editor/rich-editor.d.ts",
      "import": "./dist/components/rich-editor/rich-editor.js"
    },
    "./components/md-render": {
      "types": "./dist/components/md-render/md-render.d.ts",
      "import": "./dist/components/md-render/md-render.js"
    },
    "./components/wdf-render": {
      "types": "./dist/components/wdf-render/wdf-render.d.ts",
      "import": "./dist/components/wdf-render/wdf-render.js"
    },
    "./styles/tokens.css": {
      "types": "./dist/styles/tokens.d.css.ts",
      "default": "./dist/styles/tokens.css"
    },
    "./styles/markdown-content.css": {
      "types": "./dist/styles/markdown-content.d.css.ts",
      "default": "./dist/styles/markdown-content.css"
    },
    "./styles/rich-editor.css": {
      "types": "./dist/components/rich-editor/rich-editor.d.css.ts",
      "default": "./dist/components/rich-editor/rich-editor.css"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "site:dev": "pnpm build && pnpm --dir site dev",
    "site:build": "pnpm build && pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:typecheck": "pnpm typecheck",
    "test:site-template": "node scripts/site-template-contract.mjs",
    "check:package": "pnpm build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "verify": "pnpm typecheck && pnpm test:site-template && pnpm check:package && pnpm --dir site build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weimo-ui-core": "~0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "weimo-ui-core": "~0.1.0"
  }
}
